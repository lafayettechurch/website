# Copy to .env.local for local development; set the same values in Vercel.

# --- Sanity (content editor at /studio) — see README → "Setting up Sanity"
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the "clear the cache when someone publishes" webhook.
SANITY_REVALIDATE_SECRET=
# Only needed on your own computer, to run `npm run seed` once. Don't add it to Vercel.
SANITY_API_WRITE_TOKEN=

# --- "Let us know you're coming" form — who receives submissions.
# Pick one: the office inbox, Kyle directly, or both (comma-separated).
VISIT_FORM_TO=office.lafayettechurch@gmail.com
# Optional: also copy someone (comma-separated). Leave blank for none.
VISIT_FORM_CC=
# Sender address; must be on a domain verified in Resend (e.g. forms@lafayettechurch.org).
VISIT_FORM_FROM=Lafayette website <forms@lafayettechurch.org>
# Resend API key (https://resend.com). Without it, submissions are only logged.
RESEND_API_KEY=

# --- Church calendar (see README → "Connecting the calendar")
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=
