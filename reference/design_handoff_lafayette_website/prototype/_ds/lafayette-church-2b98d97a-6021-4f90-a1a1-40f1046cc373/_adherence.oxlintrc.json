{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/content/**",
              "components/layout/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Inter))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|icon|iconRight|disabled|fullWidth|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, icon, iconRight, disabled, fullWidth, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|outline-on-dark|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'outline-on-dark' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|eyebrow|title|children|action|facets|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, eyebrow, title, children, action, facets, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|deep|warm|outline)$/]",
        "message": "<Card> variant must be one of 'default' | 'deep' | 'warm' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:slate|clay|amber|on-dark)$/]",
        "message": "<Eyebrow> tone must be one of 'slate' | 'clay' | 'amber' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FacetMotif'] > JSXAttribute > JSXIdentifier[name!=/^(?:preset|anchor|scale|opacity|style|key|ref|className|style|children)$/]",
        "message": "<FacetMotif> doesn't accept that prop. Declared props: preset, anchor, scale, opacity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FacetMotif'] > JSXAttribute[name.name='preset'] > Literal[value!=/^(?:hero|corner|card|soft|accent)$/]",
        "message": "<FacetMotif> preset must be one of 'hero' | 'corner' | 'card' | 'soft' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FacetMotif'] > JSXAttribute[name.name='anchor'] > Literal[value!=/^(?:right|left)$/]",
        "message": "<FacetMotif> anchor must be one of 'right' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|number|eyebrow|title|lede|facets|ruled|id|padY|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionBand> doesn't accept that prop. Declared props: tone, number, eyebrow, title, lede, facets, ruled, id, padY, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|white|warm|deep|brand)$/]",
        "message": "<SectionBand> tone must be one of 'cream' | 'white' | 'warm' | 'deep' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<HeaderLink> doesn't accept that prop. Declared props: label, href."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
